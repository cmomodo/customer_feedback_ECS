# Copy to terraform.tfvars (gitignored — see repo .gitignore) and replace placeholders.
# Do not commit terraform.tfvars; it holds your VPC range, domain, and secrets.

aws_region = "us-east-1"
environment = [
  { name = "BASE_URL", value = "placeholder" },
]
domain_name      = "example.com"
base_url         = "https://example.com"
vpc_cidr         = "10.0.0.0/16"
public_subnet_1_cidr = "10.0.1.0/24"
public_subnet_2_cidr = "10.0.2.0/24"
private_subnet_1_cidr = "10.0.3.0/24"
private_subnet_2_cidr = "10.0.4.0/24"
container_port   = 3000
github_repo      = "your-username/your-repo"
ecr_repository_name = "your-ecr-repository"
image_tag        = "latest"
skip_final_snapshot = true

# Set only in private terraform.tfvars or CI secrets — never commit real values.
db_username         = "your-db-username"
db_password         = "your-db-password"
db_name             = "your-db-name"
db_identifier       = "your-db-identifier"
jwt_secret          = "your-jwt-secret"
identifier_username = "your-identifier-username"
identifier_password = "your-identifier-password"
